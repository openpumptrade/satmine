PORT=8787
# Round length and pot
ROUND_MS=180000
REWARD_SOL=0.05
PAYOUT_THRESHOLD_SOL=0.01
MIN_DIFFICULTY=16
# Shown as the CA on the mine page (pump.fun link). Leave empty for "dropping at launch".
TOKEN_MINT=
# Real payouts: base58 secret key of the reward wallet. Leave empty to run simulated (no SOL moves).
TREASURY_SECRET=
RPC_URL=https://solana-mainnet.core.chainstack.com/678a3b68b5c513362a55fdcc463304df
CLUSTER=mainnet-beta
# Where state is persisted
DATA_FILE=./data/state.json

# ---- Bitcoin engine: creator rewards → native BTC (Chainflip) → MiningRigRentals rig → pool → BTC address ----
BTC_ENGINE=0                 # 1 to run the loop (needs everything below); BTC_DRY=1 logs instead of moving funds
BTC_DRY=1
BTC_EVERY_MS=600000
HASH_PROVIDER=mrr            # mrr (no KYC) | nicehash (legacy, needs KYC)
PRIVATE_KEY=                 # engine wallet = creator wallet of the coin (base58 or JSON array)
BTC_KEEP_SOL=0.02
BTC_MIN_CLAIM_SOL=0.01
CF_SLIPPAGE_PCT=1            # Chainflip fill-or-kill tolerance; SOL is refunded to the engine wallet if it can't fill
CF_MIN_SOL=0.4               # smallest swap (Chainflip needs ≥ 40 000 sats out ≈ 0.36 SOL)
MRR_API_KEY=                 # MiningRigRentals key with "rent" permission (account → API keys); no KYC
MRR_API_SECRET=
MRR_ALGO=sha256
MRR_MIN_RENT_BTC=0.0001      # rent once the marketplace balance reaches this
MRR_RPI_MIN=85               # rig reliability score floor
MRR_HASH_MIN_TH=10
MRR_MAX_HOURS=24
MRR_MAX_PRICE_X=1.5          # skip rigs priced above 1.5× the market's lowest BTC/PH/day
BTC_ADDRESS=                 # public payout address; pool username
POOL_HOST=mine.ocean.xyz
POOL_PORT=3334
POOL_WORKER=goldvein
POOL_NAME=OCEAN
# legacy NiceHash path (HASH_PROVIDER=nicehash)
NH_API_KEY=
NH_API_SECRET=
NH_ORG_ID=
NH_TEST=0
NH_ALGORITHM=SHA256ASICBOOST_USDT
NH_LIMIT_EH=0.001
NH_PRICE_MARGIN=1.03
NH_ORDER_MIN_USDT=300
NH_REFILL_MIN_USDT=20
BTC_MIN_DEPOSIT_USDT=10
