PORT=8787
# Round length and pot
ROUND_MS=180000
REWARD_SOL=0.05
PAYOUT_THRESHOLD_SOL=0.01
MIN_DIFFICULTY=16
# Shown as the CA on the mine page (pump.fun link). Leave empty for "dropping at launch".
TOKEN_MINT=
# Real payouts: base58 secret key of the reward wallet. Leave empty to run simulated (no SOL moves).
TREASURY_SECRET=
RPC_URL=https://solana-mainnet.core.chainstack.com/678a3b68b5c513362a55fdcc463304df
CLUSTER=mainnet-beta
# Where state is persisted
DATA_FILE=./data/state.json

# ---- Bitcoin engine: creator rewards → USDT → NiceHash hashpower → pool → BTC address ----
BTC_ENGINE=0                 # 1 to run the loop (needs everything below); BTC_DRY=1 logs instead of moving funds
BTC_DRY=1
BTC_EVERY_MS=600000
PRIVATE_KEY=                 # engine wallet = creator wallet of the coin (base58 or JSON array)
BTC_KEEP_SOL=0.02
BTC_MIN_CLAIM_SOL=0.01
BTC_MIN_DEPOSIT_USDT=10
NH_API_KEY=                  # NiceHash API key with VBTD + MAPO + PRCO + VHOR permissions
NH_API_SECRET=
NH_ORG_ID=
NH_TEST=0                    # 1 → api-test.nicehash.com (keys from test.nicehash.com)
NH_ALGORITHM=SHA256ASICBOOST_USDT
NH_LIMIT_EH=0.001            # 1 PH/s
NH_PRICE_MARGIN=1.03
NH_ORDER_MIN_USDT=300        # NiceHash minimum for a new USDT order
NH_REFILL_MIN_USDT=20
BTC_ADDRESS=                 # public payout address; pool username
POOL_HOST=mine.ocean.xyz
POOL_PORT=3334
POOL_WORKER=goldvein
POOL_NAME=OCEAN
